<Window x:Class="TodoSticker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="贴纸待办"
        Width="380" Height="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        Opacity="0">

    <Window.Resources>
        <!-- 更多菜单里的文字按钮 -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 待办任务行（支持拖拽排序 / 分类标签） -->
        <DataTemplate x:Key="PendingItemTemplate">
            <Border x:Name="Row"
                    Style="{StaticResource TaskRowStyle}"
                    Background="Transparent"
                    MouseLeftButtonDown="PendingRow_MouseLeftButtonDown"
                    MouseMove="PendingRow_MouseMove"
                    MouseLeftButtonUp="PendingRow_MouseLeftButtonUp"
                    LostMouseCapture="PendingRow_LostMouseCapture">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="3"
                            CornerRadius="1.5"
                            Background="{Binding CategoryColorHex}"
                            Margin="0,2,5,2" />
                    <TextBlock Grid.Column="1"
                               Text="&#xE76F;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="9"
                               Foreground="{StaticResource TextMutedBrush}"
                               Opacity="0.45"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"
                               ToolTip="按住拖动调整顺序"
                               Cursor="SizeAll" />
                    <CheckBox Grid.Column="2"
                              Style="{StaticResource RoundCheckBoxStyle}"
                              VerticalAlignment="Center"
                              AutomationProperties.AutomationId="CompleteCheckBox"
                              AutomationProperties.Name="完成任务"
                              Click="PendingCheck_Click" />
                    <StackPanel Grid.Column="3" Margin="8,0,4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Text}" Style="{StaticResource TaskTextStyle}" />
                        <StackPanel x:Name="CategoryTag" Orientation="Horizontal" Margin="0,3,0,0" Visibility="Collapsed">
                            <Ellipse Width="6" Height="6" Fill="{Binding CategoryColorHex}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CategoryName}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="9.5"
                                       Foreground="{Binding CategoryColorHex}"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="CategoryBtn"
                            Grid.Column="4"
                            Style="{StaticResource RowIconButtonStyle}"
                            Content="&#xE8EC;"
                            AutomationProperties.AutomationId="CategoryButton"
                            AutomationProperties.Name="修改分类"
                            ToolTip="修改分类"
                            Tag="{Binding}"
                            Opacity="0.4"
                            Click="CategoryButton_Click" />
                    <Button x:Name="DeleteBtn"
                            Grid.Column="5"
                            Style="{StaticResource RowIconButtonStyle}"
                            Content="&#xE74D;"
                            AutomationProperties.AutomationId="DeleteButton"
                            AutomationProperties.Name="删除任务"
                            ToolTip="删除"
                            Opacity="0"
                            Click="PendingDelete_Click" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                    <Setter TargetName="DeleteBtn" Property="Opacity" Value="1" />
                    <Setter TargetName="CategoryBtn" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasCategory}" Value="True">
                    <Setter TargetName="CategoryTag" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 已完成任务行（显示分类标签） -->
        <DataTemplate x:Key="CompletedItemTemplate">
            <Border x:Name="Row" Style="{StaticResource TaskRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="3"
                            CornerRadius="1.5"
                            Background="{Binding CategoryColorHex}"
                            Margin="0,2,5,2" />
                    <Grid Grid.Column="1" Width="24" Height="24" VerticalAlignment="Center">
                        <Border Width="20" Height="20"
                                CornerRadius="10"
                                Background="{StaticResource GreenSoftBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="9"
                                       Foreground="{StaticResource GreenBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="2" Margin="6,0,4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Text}" Style="{StaticResource CompletedTextStyle}" />
                        <StackPanel x:Name="CategoryTag" Orientation="Horizontal" Margin="0,3,0,0" Visibility="Collapsed">
                            <Ellipse Width="6" Height="6" Fill="{Binding CategoryColorHex}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CategoryName}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="9.5"
                                       Foreground="{Binding CategoryColorHex}"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="3"
                               Text="{Binding CompletedAt, Converter={StaticResource RelativeTime}}"
                               Style="{StaticResource TimeTextStyle}"
                               Margin="4,0,2,0" />
                    <Button x:Name="CategoryBtn"
                            Grid.Column="4"
                            Style="{StaticResource RowIconButtonStyle}"
                            Content="&#xE8EC;"
                            AutomationProperties.AutomationId="CompletedCategoryButton"
                            AutomationProperties.Name="修改分类"
                            ToolTip="修改分类"
                            Tag="{Binding}"
                            Opacity="0.4"
                            Click="CategoryButton_Click" />
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="RestoreBtn"
                                Style="{StaticResource RowIconButtonStyle}"
                                Content="&#xE7A7;"
                                AutomationProperties.AutomationId="RestoreButton"
                                AutomationProperties.Name="恢复为待办"
                                ToolTip="恢复为待办"
                                Opacity="0.5"
                                Click="CompletedRestore_Click" />
                        <Button x:Name="DeleteBtn"
                                Style="{StaticResource RowIconButtonStyle}"
                                Content="&#xE74D;"
                                AutomationProperties.AutomationId="DeleteCompletedButton"
                                AutomationProperties.Name="永久删除"
                                ToolTip="永久删除"
                                Opacity="0.5"
                                Click="CompletedDelete_Click" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                    <Setter TargetName="RestoreBtn" Property="Opacity" Value="1" />
                    <Setter TargetName="DeleteBtn" Property="Opacity" Value="1" />
                    <Setter TargetName="CategoryBtn" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasCategory}" Value="True">
                    <Setter TargetName="CategoryTag" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="14">
        <Border x:Name="Card"
                CornerRadius="18"
                Background="{StaticResource CardBgBrush}"
                BorderBrush="#14000000"
                BorderThickness="1"
                Effect="{StaticResource CardShadow}">
            <Grid x:Name="CardGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ========== 顶部：拖动/折叠区 ========== -->
                <Grid Grid.Row="0">
                    <Border x:Name="HeaderDragArea"
                            Background="Transparent"
                            Cursor="SizeAll"
                            ToolTip="按住拖动位置"
                            MouseLeftButtonDown="HeaderDragArea_MouseLeftButtonDown"
                            MouseMove="HeaderDragArea_MouseMove"
                            MouseLeftButtonUp="HeaderDragArea_MouseLeftButtonUp"
                            LostMouseCapture="HeaderDragArea_LostMouseCapture" />
                    <Grid Margin="18,14,12,10" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30"
                                CornerRadius="9"
                                Background="{StaticResource AccentBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,124,0" VerticalAlignment="Center">
                            <TextBlock Text="贴纸待办"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock x:Name="HeaderSubtitle"
                                       Text="10月20日 星期二"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,12,8,0">
                        <Button x:Name="CollapseButton"
                                Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.AutomationId="CollapseButton"
                                AutomationProperties.Name="折叠或展开"
                                ToolTip="折叠成小贴纸"
                                Click="CollapseButton_Click">
                            <TextBlock x:Name="CollapseGlyph"
                                       Text="&#xE70D;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12" />
                        </Button>
                        <Button x:Name="PinButton"
                                Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.AutomationId="PinButton"
                                AutomationProperties.Name="贴到桌面"
                                ToolTip="贴到桌面"
                                Click="PinButton_Click">
                            <TextBlock x:Name="PinGlyph"
                                       Text="&#xE718;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12" />
                        </Button>
                        <Button x:Name="MoreButton"
                                Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.AutomationId="MoreButton"
                                AutomationProperties.Name="更多"
                                ToolTip="更多"
                                Click="MoreButton_Click">
                            <TextBlock Text="&#xE712;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12" />
                        </Button>
                        <Button x:Name="HideButton"
                                Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.AutomationId="HideButton"
                                AutomationProperties.Name="隐藏到托盘"
                                ToolTip="隐藏到托盘"
                                Click="HideButton_Click">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ========== 添加任务 ========== -->
                <Border x:Name="AddArea"
                        Grid.Row="1"
                        Margin="16,0,16,10"
                        Height="44"
                        CornerRadius="12"
                        Background="#F5F7FA"
                        BorderBrush="#E8EBF0"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="14,0,6,0">
                            <TextBox x:Name="TaskInput"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     MaxLength="200"
                                     VerticalAlignment="Center"
                                     AutomationProperties.AutomationId="TaskInput"
                                     AutomationProperties.Name="任务内容"
                                     TextChanged="TaskInput_TextChanged"
                                     PreviewKeyDown="TaskInput_PreviewKeyDown" />
                            <TextBlock x:Name="TaskPlaceholder"
                                       Text="添加任务，按 Enter 保存"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="12.5"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                        <Button x:Name="NewTaskCategoryButton"
                                Grid.Column="1"
                                Style="{StaticResource CategoryPickerButtonStyle}"
                                AutomationProperties.AutomationId="NewTaskCategoryButton"
                                AutomationProperties.Name="新任务分类"
                                ToolTip="选择新任务的分类"
                                Click="NewTaskCategoryButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="NewTaskCategoryDot"
                                         Width="7" Height="7"
                                         Fill="#94A3B8"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="NewTaskCategoryText"
                                           Text="未分类"
                                           FontSize="10.5"
                                           Margin="4,0,3,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70D;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="8"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddButton"
                                Grid.Column="2"
                                Style="{StaticResource AccentButtonStyle}"
                                Width="30" Height="30"
                                Margin="0,0,7,0"
                                Content="&#xE710;"
                                AutomationProperties.AutomationId="AddButton"
                                AutomationProperties.Name="添加任务"
                                ToolTip="添加任务"
                                Click="AddButton_Click" />
                    </Grid>
                </Border>

                <!-- ========== 页签 ========== -->
                <Border x:Name="TabsArea"
                        Grid.Row="2"
                        Margin="16,0,16,8"
                        CornerRadius="10"
                        Background="#F1F3F6"
                        Padding="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PendingTab"
                                Grid.Column="0"
                                Style="{StaticResource TabButtonStyle}"
                                AutomationProperties.AutomationId="PendingTab"
                                AutomationProperties.Name="待办"
                                Click="PendingTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PendingTabText" Text="待办" VerticalAlignment="Center" />
                                <Border Margin="5,0,0,0"
                                        CornerRadius="7"
                                        Background="#E4E8EE"
                                        Padding="6,1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="PendingCountText" Text="0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CompletedTab"
                                Grid.Column="1"
                                Style="{StaticResource TabButtonStyle}"
                                AutomationProperties.AutomationId="CompletedTab"
                                AutomationProperties.Name="已完成"
                                Click="CompletedTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CompletedTabText" Text="已完成" VerticalAlignment="Center" />
                                <Border Margin="5,0,0,0"
                                        CornerRadius="7"
                                        Background="#E4E8EE"
                                        Padding="6,1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="CompletedCountText" Text="0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ========== 分类筛选 ========== -->
                <ScrollViewer x:Name="CategoryArea"
                              Grid.Row="3"
                              Margin="16,0,10,6"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              Focusable="False"
                              PreviewMouseWheel="CategoryArea_PreviewMouseWheel">
                    <StackPanel x:Name="CategoryChipsPanel" Orientation="Horizontal" />
                </ScrollViewer>

                <!-- ========== 列表区 ========== -->
                <Grid x:Name="ListArea" Grid.Row="4" Margin="10,0,10,0">

                    <!-- 待办页 -->
                    <Grid x:Name="PendingPanel">
                        <ScrollViewer x:Name="PendingScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <ItemsControl x:Name="PendingList"
                                          ItemTemplate="{StaticResource PendingItemTemplate}"
                                          Margin="2,0,8,0"
                                          Focusable="False" />
                        </ScrollViewer>
                        <StackPanel x:Name="PendingEmpty"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,26"
                                    Visibility="Collapsed">
                            <Border Width="58" Height="58"
                                    CornerRadius="19"
                                    Background="#F2F5FA"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8FD;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="22"
                                           Foreground="#C3CCD9"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="PendingEmptyTitle"
                                       Text="还没有待办"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0" />
                            <TextBlock x:Name="PendingEmptyHint"
                                       Text="在上方输入，按 Enter 就添加啦"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- 已完成页 -->
                    <Grid x:Name="CompletedPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="6,0,4,2">
                            <TextBlock x:Name="CompletedSummary"
                                       Text=""
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left" />
                            <Button x:Name="ClearCompletedButton"
                                    Style="{StaticResource LinkButtonStyle}"
                                    Padding="6,3"
                                    Content="清空已完成"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.AutomationId="ClearCompletedButton"
                                    AutomationProperties.Name="清空已完成"
                                    Click="ClearCompletedButton_Click" />
                        </Grid>
                        <ScrollViewer Grid.Row="1"
                                      x:Name="CompletedScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False">
                            <ItemsControl x:Name="CompletedList"
                                          ItemTemplate="{StaticResource CompletedItemTemplate}"
                                          Margin="2,0,8,0"
                                          Focusable="False" />
                        </ScrollViewer>
                        <StackPanel x:Name="CompletedEmpty"
                                    Grid.RowSpan="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,26"
                                    Visibility="Collapsed">
                            <Border Width="58" Height="58"
                                    CornerRadius="19"
                                    Background="{StaticResource GreenSoftBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="24"
                                           Foreground="#8FD9AB"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="CompletedEmptyTitle"
                                       Text="还没有完成的任务"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0" />
                            <TextBlock Text="完成的任务会安静地待在这里"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ========== 底部 ========== -->
                <Grid x:Name="FooterArea" Grid.Row="5" Margin="18,3,10,9">
                    <TextBlock Text="Enter 添加 · 右上角折叠 · 拖动任务排序"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <Grid x:Name="ResizeGrip"
                          Width="16" Height="16"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Background="Transparent"
                          Cursor="SizeNWSE"
                          ToolTip="拖动调整大小"
                          MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                          MouseMove="ResizeGrip_MouseMove"
                          MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"
                          LostMouseCapture="ResizeGrip_LostMouseCapture">
                        <Path Stroke="#B9C2CF"
                              StrokeThickness="1.2"
                              Data="M 4 14 L 14 4 M 8 14 L 14 8 M 12 14 L 14 12"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
